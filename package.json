{
  "name": "infinyte-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "types": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write *.html src tests scripts *.json *.ts *.md docs .github/workflows",
    "format:check": "prettier --check *.html src tests scripts *.json *.ts *.md docs .github/workflows",
    "assets": "node scripts/prepare-assets.mjs",
    "export:iphone": "node scripts/export-iphone.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
